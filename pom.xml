<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>fess-sso-spnego</artifactId>
	<packaging>jar</packaging>
	<name>SPNEGO SSO Plugin</name>
	<version>15.9.0-SNAPSHOT</version>
	<description>SPNEGO/Kerberos single sign-on for Fess: the authenticator behind sso.type=spnego.</description>
	<scm>
		<connection>scm:git:git@github.com:codelibs/fess-sso-spnego.git</connection>
		<developerConnection>scm:git:git@github.com:codelibs/fess-sso-spnego.git</developerConnection>
		<url>https://github.com/codelibs/fess-sso-spnego</url>
		<tag>HEAD</tag>
	</scm>
	<parent>
		<groupId>org.codelibs.fess</groupId>
		<artifactId>fess-parent</artifactId>
		<version>15.9.0-SNAPSHOT</version>
		<relativePath />
	</parent>
	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-source-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
						<manifestEntries>
							<!-- Mounts this jar into the webapp class loader (FessWebResourceRoot). The
							     authenticator runs in the login flow: SsoAction and FessLoginAssist are
							     webapp classes, so the webapp has to see it. No child process needs it,
							     but they get WEB-INF/plugin on their class path regardless of this entry. -->
							<Fess-WebAppJar>true</Fess-WebAppJar>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<!-- No relocation. SpnegoFilterConfig keeps its parsed configuration in a
							     private static singleton and the library names its own login modules and
							     classes in messages and configuration, so a relocated copy would be a
							     second, independent instance of that global state. -->
							<!-- No artifactSet either: org.codelibs:spnego is this plugin's only
							     non-provided dependency and it has no transitive one of its own, so
							     nothing the war already carries can reach the shade. Its jaxws-rt and
							     jakarta.servlet-api are provided in its own pom, and Fess declares it
							     without exclusions. `mvn dependency:list -DincludeScope=runtime` lists
							     spnego alone; an exclude list here would have nothing to exclude.
							     Add one only if that list grows: under-excluding wastes space, but
							     over-excluding fails at run time with NoClassDefFoundError. -->
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-javadoc-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>com.mycila</groupId>
				<artifactId>license-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>net.revelc.code.formatter</groupId>
				<artifactId>formatter-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
	<!-- Fess plugins are distributed through maven.codelibs.org instead of Maven Central.
	     This cannot be inherited from fess-parent: distributionManagement is inherited
	     unconditionally, so declaring it there would also redirect the SNAPSHOT
	     deployments of fess-parent, fess, fess-crawler, fess-crawler-playwright and
	     fess-suggest, which stay on Maven Central. The scpexe transport comes from
	     the wagon-ssh-external build extension inherited from fess-parent. -->
	<distributionManagement>
		<repository>
			<id>codelibs-repo</id>
			<name>CodeLibs Repository</name>
			<url>scpexe://maven.codelibs.org/var/www/maven/release</url>
		</repository>
		<snapshotRepository>
			<id>codelibs-snapshots</id>
			<name>CodeLibs Snapshot Repository</name>
			<url>scpexe://maven.codelibs.org/var/www/maven/snapshot</url>
		</snapshotRepository>
	</distributionManagement>
	<repositories>
		<repository>
			<id>snapshots.central.sonatype.com</id>
			<url>https://central.sonatype.com/repository/maven-snapshots</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>
	<dependencies>
		<!-- Declared before spnego on purpose: Fess's own dependencies then arrive as
		     provided transitive nodes, and most of what the war carries is therefore left out of
		     the shade. Ordering does not settle every case: where the two paths disagree Maven
		     keeps one node and widens its scope, and those arrive at compile or runtime instead.
		     spnego brings no transitive dependency at all, so no such case arises here. -->
		<dependency>
			<groupId>org.codelibs.fess</groupId>
			<artifactId>fess</artifactId>
			<version>${fess.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.annotation</groupId>
			<artifactId>jakarta.annotation-api</artifactId>
			<version>${jakarta.annotation.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<!-- FilterConfig, ServletContext and HttpServletRequest/Response. SPNEGO is not
			     installed as a servlet filter here: SpnegoConfig implements FilterConfig itself so
			     that SpnegoFilterConfig can be built from the spnego.* system properties, and the
			     request and response are handed straight to the library's authenticate(). Tomcat
			     supplies these at run time. -->
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>${jakarta.servlet.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<!-- The SPNEGO/Kerberos handshake itself: SpnegoFilterConfig, SpnegoAuthenticator and
			     the SpnegoPrincipal the login credential is built from. Kept at the version
			     fess-parent pins, because the tests drive the library's own header parser and token
			     decoder to pin the exception types this plugin maps. -->
			<groupId>org.codelibs</groupId>
			<artifactId>spnego</artifactId>
			<version>${spnego.version}</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- WebContainerTestCase and its mock request, for the container the tests moved from
			     Fess run in. Fess has the same test dependency, but a test-scope dependency does not
			     transit. -->
			<groupId>org.dbflute.utflute</groupId>
			<artifactId>utflute-lastaflute</artifactId>
			<version>${utflute.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
