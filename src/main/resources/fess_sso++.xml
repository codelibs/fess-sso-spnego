<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE components PUBLIC "-//DBFLUTE//DTD LastaDi 1.0//EN"
	"http://dbflute.org/meta/lastadi10.dtd">
<components>
	<!-- Merged into Fess's fess_sso.xml. SsoManager.getAuthenticator() looks the authenticator up
	     as "<sso.type>Authenticator", so this component name is what makes sso.type=spnego work.
	     A "++" file is additive and is collected from every jar on the class path, so this does not
	     collide with another fess-sso-* plugin contributing its own authenticator.

	     Singleton, deliberately with no instance attribute: init() registers this instance with
	     ssoManager, and a prototype would register a fresh one per lookup. It is also the instance
	     destroy() disposes of, which is what releases the SPNEGO server credential. -->
	<component name="spnegoAuthenticator" class="org.codelibs.fess.sso.spnego.SpnegoAuthenticator">
	</component>
</components>
